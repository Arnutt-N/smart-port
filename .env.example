# Smart Port — ตัวอย่างค่าคอนฟิก
# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ: cp .env.example .env
# .env อยู่ใน .gitignore — ห้าม commit ค่าจริง

# ---- MySQL (docker-compose service "db") ----------------------------------
# ต้องตั้งครบทุกตัว ไม่งั้น container db จะ start ไม่ขึ้น
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=civil_service_mgmt
MYSQL_USER=smartport
MYSQL_PASSWORD=change-me

# ---- Backend --------------------------------------------------------------
# กุญแจเซ็น JWT (HMAC-SHA256) — production ต้องสุ่มใหม่ อย่าใช้ค่าตัวอย่าง
# สร้างค่าใหม่: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ค่าที่มี default ในโค้ดอยู่แล้ว — ตั้งเมื่อต้องการ override เท่านั้น
# APP_ENV=development                       # เปิดผ่อนปรน CORS สำหรับ dev (backend/api.php)
# ALLOWED_ORIGINS=http://localhost:5174      # คั่นหลายค่าด้วย comma (default: โดเมน production)
# OCR_SERVER_URL=http://127.0.0.1:8100       # OCR sidecar (backend/routes/ocr.php)

# ---- Migrations -----------------------------------------------------------
# docker-compose ตั้ง APPLY_TEST_SEED_MIGRATIONS=1 ให้แล้วสำหรับ local
# ห้ามตั้งเป็น 1 บน production — จะทำให้ข้อมูลทดสอบหลุดขึ้นระบบจริง
# APPLY_TEST_SEED_MIGRATIONS=0
# RUN_MIGRATIONS=1                           # ตั้ง 0 เพื่อข้าม run-migrations.php ตอน container start

# ---- Frontend (build-time) ------------------------------------------------
# ค่านี้ส่งผ่าน build arg ใน docker-compose อยู่แล้ว (ดู frontend.build.args)
# VITE_API_URL=/api
