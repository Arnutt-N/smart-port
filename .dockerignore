# Ignore Git and version control files
.git
.gitignore

# Ignore environment files (sensitive data)
.env
.env.example

# Ignore IDE/editor files
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Ignore logs and temporary files
logs/
tmp/
*.log
*.tmp
*.bak

# Ignore build outputs and caches
dist/
build/
.cache/

# For frontend (Vite/Node.js)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# For backend (PHP/Composer)
vendor/
# ห้าม ignore composer.lock — Dockerfile ทั้ง repo-root และ backend/ ทำ
# `COPY composer.json composer.lock* ./` แล้วรัน `composer install`
# ถ้า ignore ไฟล์นี้ install จะ resolve เวอร์ชันใหม่เอง = build ไม่ deterministic
# (บรรทัดเดิมเขียน inline comment ซึ่ง Docker ไม่รองรับ จึงกลายเป็น pattern ที่ไม่ match อะไร)
.phpunit.result.cache

# Ignore uploads and runtime data (จัดการด้วย volumes ใน production)
uploads/
photos/
documents/

# Ignore test and development files
tests/
coverage/
phpunit.xml

# Ignore SQL dumps and backups — keep repo migrations for backend Docker image
*.sql
!database/
!database/**
*.sql.gz
backups/

# Ignore Docker-related files (ไม่ copy เข้า image)
docker-compose.yml
.dockerignore